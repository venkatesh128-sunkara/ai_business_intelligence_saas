# Copy to .env and adjust.

# --- Database (SQLite default; switch to PostgreSQL for production) ---
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/bi_saas
DATABASE_URL=sqlite:///./bi_saas.db

# --- Auth ---
SECRET_KEY=please-change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- LLM (OpenAI-compatible). Leave OPENAI_API_KEY empty to use the
#     built-in rule-based NL2SQL fallback engine. ---
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# For Google Gemini use:
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OPENAI_MODEL=gpt-4o-mini

# --- Admin bootstrap ---
ADMIN_EMAIL=admin@insightiq.dev
ADMIN_PASSWORD=admin123

# --- Uploads ---
MAX_UPLOAD_MB=50

# --- CORS (JSON array or comma-separated list) ---
# CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
